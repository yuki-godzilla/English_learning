{
  "name": "yuki-chappy-english-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-based English learning progress dashboard generator",
  "type": "module",
  "scripts": {
    "build:chart": "node generate_english_progress_chart.mjs",
    "build:chart:publish": "node generate_english_progress_chart.mjs --publish-assets",
    "check": "node --check generate_english_progress_chart.mjs",
    "journal:build": "node scripts/build-github-journal.mjs",
    "journal:check": "node scripts/build-github-journal.mjs --check",
    "records:check": "node scripts/validate-learning-records.mjs",
    "site:prepare": "npm run build:chart && npm run journal:check && npm run records:check && node scripts/build-learning-site.mjs",
    "site:build": "npm run site:prepare && node scripts/run-mkdocs.mjs build --strict",
    "site:check": "npm run site:build && node scripts/validate-learning-site.mjs",
    "site:serve": "npm run site:prepare && node scripts/run-mkdocs.mjs serve -a 127.0.0.1:8000",
    "test": "npm run check && npm run build:chart && npm run journal:check && npm run records:check",
    "pronunciation:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-pronunciation.ps1",
    "pronunciation:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pronunciation-recording.ps1 -Action Status",
    "pronunciation:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pronunciation-recording.ps1 -Action Start",
    "pronunciation:collect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pronunciation-recording.ps1 -Action Collect",
    "pronunciation:analyze": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pronunciation-recording.ps1 -Action Analyze"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "sharp": "0.35.3"
  }
}
